{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/commentary-index.schema.json",
  "title": "Lamplighter commentary pack index (_index.json)",
  "type": "object",
  "required": [
    "type",
    "formatVersion",
    "parts",
    "books"
  ],
  "properties": {
    "type": {
      "const": "commentary-index"
    },
    "formatVersion": {
      "const": 1
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "file",
          "entryCount",
          "bytes",
          "sha256"
        ],
        "properties": {
          "file": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.json$"
          },
          "entryCount": {
            "type": "integer",
            "minimum": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "books": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^(0|[1-9][0-9]*)$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "chapters"
        ],
        "properties": {
          "names": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "whole": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "chapters": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[1-9][0-9]*$"
            },
            "additionalProperties": {
              "type": "array",
              "minItems": 1,
              "items": {
                "oneOf": [
                  {
                    "type": "integer",
                    "minimum": 0
                  },
                  {
                    "type": "array",
                    "items": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "integer",
                        "minimum": 1
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 3,
                    "additionalItems": false
                  }
                ]
              }
            }
          }
        }
      }
    }
  }
}
