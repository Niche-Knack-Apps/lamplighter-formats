{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/lexicon.schema.json",
  "title": "Lamplighter lexicon",
  "type": "object",
  "required": [
    "meta",
    "entries"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "versification": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "referenceBooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "entries": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[GH][0-9]+$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "def"
        ],
        "properties": {
          "word": {
            "type": "string"
          },
          "translit": {
            "type": "string"
          },
          "pron": {
            "type": "string"
          },
          "derivation": {
            "type": "string"
          },
          "def": {
            "type": "string"
          },
          "kjvDef": {
            "type": "string"
          },
          "strongs": {
            "type": "string",
            "pattern": "^[GH][0-9]+$"
          }
        }
      }
    }
  }
}
