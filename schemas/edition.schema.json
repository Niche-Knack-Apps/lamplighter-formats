{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/edition.schema.json",
  "title": "Lamplighter edition",
  "description": "Legacy-compatible v1 edition. Run the linter for positional numbering and duplicate checks that JSON Schema cannot express.",
  "type": "object",
  "required": [
    "books"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "versification": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "referenceBooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "chapters"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "book": {
            "type": "string",
            "minLength": 1
          },
          "abbrev": {
            "type": "string"
          },
          "abbr": {
            "type": "string"
          },
          "osis": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "verses"
              ],
              "properties": {
                "chapter": {
                  "type": "integer",
                  "minimum": 1
                },
                "verses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "verse": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "anyOf": [
          {
            "required": [
              "name"
            ]
          },
          {
            "required": [
              "book"
            ]
          }
        ]
      }
    }
  }
}
