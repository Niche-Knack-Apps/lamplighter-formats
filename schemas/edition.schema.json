{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/edition.schema.json",
  "title": "Lamplighter edition",
  "description": "A Bible edition: books, chapters, verses, text. Verses are read by position.",
  "type": "object",
  "required": [
    "books"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "textDirection": {
      "type": "string",
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "books": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "chapters"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "abbrev": {
            "type": "string"
          },
          "chapters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "verses"
              ],
              "properties": {
                "chapter": {
                  "type": "integer",
                  "minimum": 1
                },
                "verses": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "verse": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "text": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
