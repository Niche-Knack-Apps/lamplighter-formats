{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/cross-references.schema.json",
  "title": "Lamplighter cross-references",
  "type": "object",
  "required": [
    "meta",
    "refs"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "versification": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "referenceBooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "abbreviation": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "languageEnglishName": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "license_url": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "versification": {
          "type": "string"
        },
        "formatVersion": {
          "const": 1
        },
        "textDirection": {
          "enum": [
            "ltr",
            "rtl"
          ]
        },
        "source": {
          "type": "string"
        },
        "referenceBooks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "id": {
          "type": "string"
        },
        "type": {
          "const": "cross_reference"
        }
      }
    },
    "refs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.[1-9][0-9]*\\.[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[1-9][0-9]*\\.[1-9][0-9]*$"
            },
            "endRef": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.[1-9][0-9]*\\.[1-9][0-9]*$"
            },
            "weight": {
              "type": "number"
            }
          }
        }
      }
    }
  }
}
