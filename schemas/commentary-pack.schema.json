{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/commentary-pack.schema.json",
  "title": "Lamplighter commentary pack metadata (_metadata.json)",
  "type": "object",
  "required": [
    "name",
    "type",
    "formatVersion",
    "entryCount"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "versification": {
      "type": "string"
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "referenceBooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type": {
      "const": "commentary-pack"
    },
    "formatVersion": {
      "const": 1
    },
    "entryCount": {
      "type": "integer",
      "minimum": 1
    },
    "entries": false,
    "parts": false,
    "books": false
  }
}
