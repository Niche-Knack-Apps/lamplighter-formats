{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/Niche-Knack-Apps/lamplighter-formats/schemas/commentary.schema.json",
  "title": "Lamplighter commentary",
  "type": "object",
  "required": [
    "name",
    "type",
    "entries"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "abbreviation": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "languageEnglishName": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "license_url": {
      "type": "string"
    },
    "attribution": {
      "type": "string"
    },
    "versification": {
      "type": "string"
    },
    "formatVersion": {
      "const": 1
    },
    "textDirection": {
      "enum": [
        "ltr",
        "rtl"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "referenceBooks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "type": {
      "const": "commentary"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "range",
          "content"
        ],
        "properties": {
          "range": {
            "type": "object",
            "required": [
              "start"
            ],
            "properties": {
              "start": {
                "type": "object",
                "required": [
                  "book_index"
                ],
                "properties": {
                  "book": {
                    "type": "string"
                  },
                  "book_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "chapter": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verse": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "dependencies": {
                  "verse": [
                    "chapter"
                  ]
                }
              },
              "end": {
                "type": "object",
                "required": [
                  "book_index"
                ],
                "properties": {
                  "book": {
                    "type": "string"
                  },
                  "book_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "chapter": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "verse": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "dependencies": {
                  "verse": [
                    "chapter"
                  ]
                }
              }
            }
          },
          "title": {
            "type": "string"
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
